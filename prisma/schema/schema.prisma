// Shared generator + datasource. Each module owns its own <module>.prisma file
// in this folder (multi-file schema). Schema is applied with `prisma db push`;
// there are no migration files.

generator client {
  provider   = "prisma-client-js"
  // Rust-free client (wasm query compiler + @prisma/adapter-pg); no engine download.
  engineType = "client"
  previewFeatures = ["queryCompiler"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
